# ============================================================================
# Variables de entorno del proyecto — copiá este archivo a `.env` y completá
# los valores. El proyecto funciona en local con la base de datos PostgreSQL.
# ============================================================================

# --- Base de datos (Prisma / PostgreSQL) -----------------------------------
# URL de conexión principal de Prisma. Obligatoria.
# Ejemplo local: postgresql://usuario:password@localhost:5432/gestion_legal?schema=public
DATABASE_URL=

# URL de conexión directa (sin pooler). Prisma la usa para migraciones y
# operaciones que requieren una conexión directa (ej. Supabase, Neon).
# Si no usás un pooler, podés dejarla igual que DATABASE_URL.
DIRECT_URL=

# --- Autenticación (Auth.js / NextAuth v5) ---------------------------------
# Secreto usado para firmar las sesiones. Obligatorio.
# Generá uno con: npx auth secret
AUTH_SECRET=

# Variables heredadas de NextAuth v4 (opcionales en v5, se mantienen por
# compatibilidad). AUTH_URL apunta a la URL base del deploy en producción.
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# --- IA / verificación de fuentes legales (Gemini) -------------------------
# Clave de API de Google Gemini, necesaria para el módulo de análisis y
# verificación de fuentes legales oficiales. Obtenela en Google AI Studio.
GEMINI_API_KEY=
