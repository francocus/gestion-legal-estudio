generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  docType     String   @default("DNI")
  dni         String?  @unique
  cuit        String?  @unique
  gender      String?
  birthDate   DateTime?
  birthPlace  String?
  nationality String?  @default("Argentina")
  occupation  String?
  civilStatus String?
  address     String?
  location    String?
  email       String?
  phone       String?
  familyPhone String?
  createdAt   DateTime @default(now())
  cases       Case[]
  events      Event[]
}

model Case {
  id              String           @id @default(cuid())
  code            String?
  caratula        String
  juzgado         String?
  description     String?
  status          CaseStatus       @default(ACTIVE)
  isExtrajudicial Boolean          @default(false)
  totalFee        Int?             @default(0)
  driveLink       String?
  area            String           @default("CIVIL")
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  events          Event[]
  movements       Movement[]
  documents       CaseDocument[]
  transactions    Transaction[]
  notes           Note[]
  entries         AccountEntry[]
  legalSources    CaseLegalSource[]
  createdAt       DateTime         @default(now())
}

model CaseDocument {
  id         String   @id @default(cuid())
  fileName   String
  filePath   String
  uploadedAt DateTime @default(now())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Event {
  id                 String            @id @default(cuid())
  title              String
  date               DateTime
  type               EventType
  description        String?
  isDone             Boolean           @default(false)
  caseId             String?
  clientId           String?
  appointmentStatus  AppointmentStatus?
  appointmentMode    AppointmentMode?
  durationMinutes    Int?
  depositAmount      Float?
  depositPaid        Boolean           @default(false)
  case               Case?             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client             Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

model Movement {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime @default(now())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documents   MovementDocument[]
}

model MovementDocument {
  id         String   @id @default(cuid())
  fileName   String
  filePath   String
  uploadedAt DateTime @default(now())
  movementId String
  movement   Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)
}

enum CaseStatus {
  ACTIVE
  ARCHIVED
  MEDIATION
}

enum EventType {
  HEARING
  DEADLINE
  MEETING
  APPOINTMENT
  PERSONAL
  MEDICAL
  SOCIAL
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentMode {
  IN_PERSON
  PHONE
  VIDEO
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Float
  type        String
  description String
  date        DateTime @default(now())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model User {
  id                String          @id @default(cuid())
  email             String          @unique
  password          String
  name              String?
  role              String          @default("ADMIN")
  status            String          @default("ACTIVE")
  mustChangePassword Boolean        @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime        @default(now())
  auditLogs         UserAuditLog[]
}

model UserAuditLog {
  id         String   @id @default(cuid())
  userId     String
  actorEmail String?
  action     String
  details    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(cuid())
  content   String
  type      String   @default("TEXT")
  createdAt DateTime @default(now())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model AccountEntry {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  description String
  concept     String
  debe        Float    @default(0)
  haber       Float    @default(0)
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model LegalSource {
  id              String           @id @default(cuid())
  title           String
  officialNumber  String?
  officialName    String?
  type            LegalSourceType
  area            String
  country         String           @default("Argentina")
  content         String
  officialText    String?
  sourceUrl       String?
  publicationDate DateTime?
  validityStatus  String?
  relatedRule     String?
  lastAiCheck     DateTime?
  isOutdated      Boolean          @default(false)
  previousText    String?
  cases           CaseLegalSource[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model CaseLegalSource {
  id            String      @id @default(cuid())
  caseId        String
  legalSourceId String
  createdAt     DateTime    @default(now())
  case          Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  legalSource   LegalSource @relation(fields: [legalSourceId], references: [id], onDelete: Cascade)

  @@unique([caseId, legalSourceId])
}

enum LegalSourceType {
  LAW
  CODE
  CONSTITUTION
  JURISPRUDENCE
  OTHER
}
